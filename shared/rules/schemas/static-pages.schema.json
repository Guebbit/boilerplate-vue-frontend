{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
        "pages": {
            "minItems": 1,
            "type": "array",
            "items": {
                "type": "string",
                "pattern": "^[a-z]+$"
            }
        }
    },
    "required": ["pages"],
    "additionalProperties": false
}
