{
    "*.{ts,mts,tsx,vue,cjs}": [
        "eslint --fix --max-warnings 0 --no-warn-ignored",
        "prettier --write --ignore-unknown"
    ],
    "{src/styles/**/*.css,scripts/design-policy.ts,scripts/eslint/**/*.ts,src/ui/vuetify/theme.ts}": "node --max-old-space-size=8192 node_modules/eslint/bin/eslint.js --max-warnings 0 --no-warn-ignored src",
    "!(*.{ts,mts,tsx,vue,cjs})": "prettier --write --ignore-unknown"
}
