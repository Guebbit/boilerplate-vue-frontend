# ============================================
# Stage 1: Builder — install deps & build VitePress
# ============================================
FROM docker.io/library/node:26.13.1-alpine@sha256:6bd9ab43c0ec0190ca7b2d193906cb8b7edf6e7f4afa43ddeccd6452710bffb5 AS builder

WORKDIR /app

# Copy dependency manifests first (better layer caching)
# .npmrc rides along: its legacy-peer-deps decides what `npm ci` expects in the lockfile.
COPY package*.json .npmrc ./

# Install all dependencies (including devDeps needed by VitePress)
RUN npm ci --ignore-scripts

# Copy source + docs
COPY . .

# The generated contract code is gitignored: rebuild it here, so the docs build sees the tree a
# normal install gives. `--ignore-scripts` above skipped `postinstall`.
RUN npm run regenerate

# Build the static VitePress site into docs/.vitepress/dist
RUN npm run docs:build

# ============================================
# Stage 2: Server — serve static files with Nginx
# ============================================
FROM docker.io/library/nginx:1.31.8-alpine@sha256:fed7e14be83cbd2661a75cdc5b872d936cf155d46c327084d30b8df19ae88d72

# Remove default nginx static assets
RUN rm -rf /usr/share/nginx/html/*

# Copy built VitePress output from builder stage
COPY --from=builder /app/docs/.vitepress/dist /usr/share/nginx/html

# Custom nginx config (optional: SPA-like fallback, caching headers)
COPY docker/nginx.docs.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]