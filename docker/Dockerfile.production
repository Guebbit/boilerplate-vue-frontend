# Production image for the frontend.
#
# `docker/Dockerfile` is the DEVELOPMENT image: it installs everything and runs the Vite dev
# server with hot reload. That server is not a web server for a deployment — it transpiles on
# demand, ships source maps and an unminified module graph, and is documented by Vite as
# development-only.
#
# This file is the other half: Vite produces a directory of static files, and nginx serves it.
# Node is present only in the build stage and does not exist in the shipped image.
#
# Build:  docker build -f docker/Dockerfile.production -t boilerplate-frontend:latest .
# Run:    docker compose -f docker-compose.production.yml up -d
#
# ── ONE IMAGE, CONFIGURED WHEN IT STARTS ─────────────────────────────────────────────────────────
# `import.meta.env.VITE_*` is still replaced with a literal while Vite bundles — that has not
# changed, and never will for `VITE_APP_BASE_URL` below: Vite bakes it into every asset URL, so it
# has to be a build argument. Every OTHER deployment value (the API origin, telemetry, locale
# defaults, log level, upload/timeout limits) is no longer a build arg. `docker/docker-entrypoint.d/`
# writes them into `/config.js` from this CONTAINER's own environment at start; `index.html` loads
# it before the app bundle, and `src/infrastructure/runtime-config.ts` is the one reader —
# `runtimeValue('API_URL') ?? import.meta.env.VITE_API_URL ?? ''`. So:
#
#   docker build -f docker/Dockerfile.production -t boilerplate-frontend:production .
#   docker run -e VITE_API_URL=https://api.example.com -p 8080:80 boilerplate-frontend:production
#
# One image, promoted staging → production; a config change is a restart, not a rebuild.

# ────────────────────────────────────────────────────────────────────────────────────────────────
# Stage 1 — build: type-check, then bundle.
# ────────────────────────────────────────────────────────────────────────────────────────────────
FROM docker.io/library/node:24-alpine AS build

WORKDIR /app

# Manifests first so the install layer survives every change that is not a dependency change.
# `.npmrc` rides along: its `legacy-peer-deps` is part of how the lockfile was resolved, and
# without it `npm ci` reports optional peers (search-insights) as missing from the lock.
COPY package.json package-lock.json .npmrc ./

RUN npm ci

COPY . .

# The one build-time value left: Vite bakes it into every emitted asset URL, so a running
# container cannot change it. Everything else moved to `config.js` above.
ARG VITE_APP_BASE_URL
ENV VITE_APP_BASE_URL=$VITE_APP_BASE_URL

# `npm run build` is `run-p type-check-only build-only`, so `vue-tsc` runs alongside the bundle and
# a type error stops the image from being produced. That check is worth more here than anywhere
# else: Vitest does not type-check (see the note in `vitest.config.ts`), so a green test run is not
# evidence that this compiles.
RUN npm run build

# `vite.config.ts` sets `build.sourcemap: 'hidden'` (FA97): a map is written next to every chunk,
# but no chunk carries the `//# sourceMappingURL` comment pointing a browser at it. `hidden` means
# "for a crash reporter to fetch privately", never "safe to serve" — nginx has no rule blocking
# `.map` requests below, so a map left in `dist/` is one guessed URL away from handing out
# unminified source. Deleted here, before the copy into the runtime stage, rather than relying on
# a server-side block: the release workflow already pulled its own copy of these out of a plain
# `npm run build` before this image is ever built, to publish alongside the GitHub Release instead.
RUN find dist -name '*.map' -type f -delete

# ────────────────────────────────────────────────────────────────────────────────────────────────
# Stage 2 — serve: nginx and a directory of files. No Node, no npm, no source.
# ────────────────────────────────────────────────────────────────────────────────────────────────
FROM docker.io/library/nginx:1-alpine AS runtime

# `nginx.conf` carries the SPA fallback, the cache policy and the security headers. Kept as a file
# in the repo rather than a heredoc here so it is diffable and can be linted.
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# Runs before nginx starts (the base image sources every executable `*.sh` here): writes
# `config.js` from THIS container's own environment, every time it starts.
COPY docker/docker-entrypoint.d/40-generate-runtime-config.sh /docker-entrypoint.d/

# Same hook: writes `/.well-known/security.txt` when the operator opts in, and nothing otherwise.
COPY docker/docker-entrypoint.d/41-generate-security-txt.sh /docker-entrypoint.d/

# Only the build output. Nothing that produced it comes along.
COPY --from=build /app/dist /usr/share/nginx/html

# The nginx image ships an unprivileged `nginx` user, and the alpine variant is already set up to
# run as it: the master process binds port 80 as root and drops privileges for the workers. Ports
# below 1024 need that root bind, which is why this does NOT switch to `USER nginx` — doing so
# fails to bind unless the listen port moves too. Publish it behind a proxy and the distinction
# stops mattering; the containers here are not reachable from outside the network.
EXPOSE 80

# Serving static files has no application health to speak of, so the check asks the only question
# that matters: is nginx answering, and is index.html where it should be.
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://127.0.0.1/ || exit 1

# `daemon off;` keeps nginx in the foreground so the container lives as long as the server does and
# Docker can see it exit. This is the base image's own default command, restated because a future
# edit that adds an ENTRYPOINT would otherwise silently lose it.
CMD ["nginx", "-g", "daemon off;"]
