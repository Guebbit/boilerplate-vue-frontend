# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# local env
.env
.env.local
.env.*.local

# tests
/tests/e2e/videos/
/tests/e2e/screenshots/
/tests/e2e/downloads/
tests_output/

# mutation testing (stryker sandbox + html report)
.stryker-tmp

# Mutation reports are generated, the incremental cache included. It is a CACHE and nothing
# automated reads it: `mutation.yml` passes `--force` to rebuild from scratch, and the PR run that
# would consume it does not exist. A local run still keeps and reuses its own copy on disk.
reports/*

# vitepress
docs/.vitepress/dist
docs/.vitepress/cache

# generic
node_modules
.DS_Store
dist
dist-e2e
dist-ssr
coverage
*.local
*.zip

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

*.tsbuildinfo
.claude

# The optional symlink that exposes tests/audit/*.md as Claude Code slash commands — see
# docs/tools/ai-auditing.md. The prompts themselves are versioned; this is one developer's
# convenience, regenerable with a single ln -s.
/.claude/commands/audit

# graphify (code-graph tool) cache — generated, never committed
graphify-out/

# 2repo:start — regenerate with: 2repo <repo-path>
.2repo/graphify-out/cache/
.2repo/graphify-out/graph.json
.2repo/graphify-out/manifest.json
.2repo/graphify-out/.graphify_analysis.json
.2repo/graphify-out/.graphify_labels.json*
.2repo/graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
.2repo/wiki/.wiki-cache.json
.2repo/modules/.modules-cache.json
.codeboarding/
# 2repo:end
