# App settings
VITE_APP_DEFAULT_LOCALE = en
# Locale used when a key is missing from the active locale (vue-i18n fallbackLocale)
VITE_APP_FALLBACK_LOCALE = en
VITE_APP_SUPPORTED_LOCALES = en,it,es
# Placeholder rendered whenever a display value is empty or unavailable
VITE_APP_EMPTY_VALUE = —
# Sub-path the app is served from, e.g. '/app/'. Passed to createWebHistory, so it prefixes every
# URL the router generates as well as the one it reads. Leave commented when serving from the
# domain root — an unset value and '/' behave identically, and Vite's own BASE_URL follows it.
#VITE_APP_BASE_URL =

# API settings
# This repo owns the 8080-8099 host-port block; the paired backend owns 3000-3099.
# 8080 = dev server, 8085 = e2e vite server (see package.json), 8090 = docs container.
VITE_APP_PORT = 8080
VITE_DOCS_PORT = 8090
VITE_API_URL = http://localhost:3000
VITE_API_SSE = http://localhost:3000/observability/events
# Largest image upload the client will offer to send, in bytes. Must follow the backend's
# NODE_MAX_UPLOAD_BYTES; unset (or non-numeric) uses the same 5 MB default the backend does.
# Client-side only — the backend gates every upload regardless. See src/utils/uploads.ts.
VITE_MAX_UPLOAD_BYTES = 5242880
# Backend pairing tip:
# set NODE_CORS_ORIGIN=http://localhost:8080 in boilerplate-node-backend `.env`
# If true, API calls will be mocked using mock instead
VITE_API_MOCK_ENABLED = false
# If true/false, forces orvalMutator to parse (or skip parsing) every response through its
# OpenAPI-derived Zod schema, throwing on a mismatch. Unset defaults to DEV (on for `vite dev`,
# off for a production build). `test:e2e:live` sets it explicitly so a live contract violation
# fails the run instead of only surfacing if some unrelated assertion trips on it.
VITE_VALIDATE_RESPONSES =

# Paired backend checkout
# Where the other half of this pair lives on disk. Unprefixed on purpose: it names a repo, not a
# browser setting, and never reaches the app bundle.
# Read by `npm run check:spec-identity` (which compares the shared contract files) and by
# cypress.config.ts (which shells into it for `cy.resetState()` during `test:e2e:live`).
# Unset falls back to the sibling-directory convention, `../boilerplate-node-backend`.
# When neither resolves, check:spec-identity SKIPS rather than fails — except under CI, where a
# missing sibling means the workflow is misconfigured. See scripts/check-spec-identity.ts.
BACKEND_PATH =

# Axios settings
VITE_AXIOS_TIMEOUT = 10000

# Logging. Mirrors the API's NODE_LOG_LEVEL: error | warn | info | debug.
# Default: 'debug' in development, 'warn' in production.
VITE_APP_LOG_LEVEL = debug
# Which areas emit debug/info output: comma-separated, or '*' for all. Empty means none, so a
# per-navigation or per-request trace stays opt-in. Known areas: router, http, observability, demo.
VITE_APP_LOG_SCOPES =

# Grafana Faro settings (error/crash monitoring + FE tracing + web-vitals)
# The browser only ever talks to Grafana Alloy's Faro receiver, which fans out
# to Loki/Tempo/Prometheus. If VITE_FARO_URL is empty, Faro is disabled.
VITE_FARO_URL = http://localhost:12347/collect
VITE_FARO_APP_NAME = frontend
VITE_FARO_APP_VERSION = 1.0.0
VITE_FARO_ENVIRONMENT = local
# Note: traces are stitched onto the backend using VITE_API_URL as the origin
# the W3C `traceparent` header is propagated to.

# Umami settings (product analytics: pageviews + custom events)
# If VITE_UMAMI_WEBSITE_ID is empty, Umami is disabled and the tracker is never injected.
#
# The id below is not a placeholder: the paired backend's compose stack seeds a website with
# exactly this fixed UUID (UMAMI_WEBSITE_ID in its .env-example) precisely so this file can name
# it up front, instead of asking you to boot Umami, create a website and paste back the random id
# it generates. Leaving it blank meant a fresh clone ran the whole stack with analytics silently
# off — nothing was broken, no event was ever recorded, and nothing said so.
#
# Pointing at a Umami you did not start from that compose file? Then it IS a placeholder: take
# the real id from the Umami dashboard (Settings → Websites), because events carrying an unknown
# website id are dropped on arrival.
VITE_UMAMI_SRC = http://localhost:3080/script.js
VITE_UMAMI_WEBSITE_ID = 00000000-0000-4000-8000-000000000001

# Mutation-run machine settings (see scripts/mutation.ts)
# Both are properties of THIS machine, not of the project, which is why they live here rather than
# in the committed stryker.config.json. A CLI flag beats either, so CI (which has no .env) keeps
# using the numbers mutation.yml passes.
# Workers to run in parallel. The ceiling is RAM divided by the cap below, not core count.
STRYKER_CONCURRENCY = 8
# Per-worker V8 heap cap, in MB. Unset lets Node derive it from total system RAM (4288 MB on a
# 30 GB box), which hands a leak a longer runway on a bigger machine.
STRYKER_WORKER_HEAP_MB = 2048

# Cypress e2e shards — how many Cypress processes run in parallel against the one dev server.
# Machine-dependent like the Stryker knobs: each shard is a browser at roughly 0.5-1 GB. Wall-clock
# cannot fall below the longest single spec (~86s), so past ~6 there is little left to win.
E2E_SHARDS = 4
