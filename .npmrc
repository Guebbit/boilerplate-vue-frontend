# @tanstack/vue-query lists @vue/composition-api (a Vue 2-only shim) as an
# optional peer. It is never installed on this Vue 3 project, but npm's
# strict ERESOLVE still walks its own (Vue 2) peer requirement and refuses.
# https://github.com/npm/cli/issues/6929 is the same class of false positive.
legacy-peer-deps=true
