# Dependencies (installed inside the container)
node_modules

# Version control
.git

# Secrets. `.env*` rather than the exact spelling: a backup, an export or a tool's scratch copy
# (`.env.bak`, `.env.save`) carries the same secrets as `.env` itself. `!.env-example` matches
# `.gitignore`'s own rule for the same reason.
.env*
!.env-example

# IDE
.idea

# App build output
dist
dist-e2e

# VitePress build output and dep cache (both rebuilt inside the docs container)
docs/.vitepress/dist
docs/.vitepress/cache

# Test and analysis output. None of it reaches the bundle, and every megabyte here is copied into
# the build context on every build.
coverage
reports
.stryker-tmp

# Cypress artefacts from a local run. Screenshots and videos are large and are regenerated by CI.
tests/e2e/screenshots
tests/e2e/videos

# Logs
*.log
