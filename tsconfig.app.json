{
    "extends": "@vue/tsconfig/tsconfig.dom.json",
    // The application and the generated client, and nothing from `tests/`: `support/e2e` needs
    // Cypress' ambient types and `support/unit` needs Vitest's, so both belong to their own
    // projects rather than to this one.
    "include": ["contracts/rest", "src/**/*", "src/**/*.vue"],
    "exclude": ["src/modules/*/tests/**"],
    "compilerOptions": {
        "target": "ESNext",
        "lib": ["ESNext", "DOM"],
        "strict": true,
        "composite": true,
        "noEmit": true,
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

        "types": ["vite/client"],

        "baseUrl": ".",
        "paths": {
            "@/*": ["./src/*"],
            "@types": ["./src/types"],
            // The generated client and its Zod schemas. Aliased rather than reached by relative
            // path because every module's store imports them from its own folder depth, and one
            // entry here is what makes regenerating them somewhere else a one-line change.
            "@api": ["./contracts/rest/index"],
            "@api/schemas": ["./contracts/rest/schemas.zod"]
        }
    }
}
