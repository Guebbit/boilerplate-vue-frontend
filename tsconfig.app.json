{
    "extends": "@vue/tsconfig/tsconfig.dom.json",
    // `tests/support/mocks` only, not all of `tests/support`: the app genuinely imports the
    // mock layer (lazily, behind VITE_API_MOCK_ENABLED), while `support/e2e` needs Cypress
    // ambient types and `support/unit` needs Vitest's. Those belong to their own projects.
    "include": [
        "contracts/rest",
        "src/**/*",
        "src/**/*.vue",
        "tests/support/mocks/**/*",
        ".dev/**/*.ts"
    ],
    "exclude": ["src/**/__tests__/*", "src/modules/*/tests/**"],
    "compilerOptions": {
        "target": "ESNext",
        "lib": ["ESNext", "DOM"],
        "strict": true,
        "composite": true,
        "noEmit": true,
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

        "types": ["vite/client"],

        "baseUrl": ".",
        "paths": {
            // The TypeScript half of vite.config.ts's `resolve.dedupe`, and needed for the same
            // reason: while `@guebbit/*` is npm-linked, TS follows the symlink to a checkout that
            // carries its own `vue`/`pinia`, and then resolves the toolkit's `Ref<T>` from a
            // DIFFERENT copy of @vue/reactivity than the app's. The two are structurally
            // identical and nominally distinct, so every `storeToRefs` result is "not assignable
            // to" itself — hundreds of errors that say nothing about the code.
            //
            // Pinning them here makes the whole program agree on one copy. Harmless once the
            // packages come from npm again.
            "vue": ["./node_modules/vue"],
            "pinia": ["./node_modules/pinia"],
            "vue-router": ["./node_modules/vue-router"],
            "vue-i18n": ["./node_modules/vue-i18n"],
            // `@tanstack/query-core` is a required peer of @guebbit/vue-toolkit, and the stores
            // now spread the toolkit's whole surface — `queryClient` included — so its type is
            // part of their inferred type. Without this it resolves to the copy nested inside the
            // linked checkout, and TS refuses to name a type from a path it considers unportable.
            "@tanstack/query-core": ["./node_modules/@tanstack/query-core"],
            "@/*": ["./src/*"],
            "@types": ["./src/types"],
            // The mock layer's shared helpers. Aliased rather than reached by relative path
            // because a module's handlers now live in `src/modules/<name>/mocks/`, and
            // `../../../../tests/support/mocks/...` from there is both unreadable and brittle. One entry
            // here is also what makes relocating the mock layer a one-line change.
            "@mocks/*": ["./tests/support/mocks/*"],
            "@api": ["./contracts/rest/index"],
            "@api/schemas": ["./contracts/rest/schemas.zod"]
        }
    }
}
